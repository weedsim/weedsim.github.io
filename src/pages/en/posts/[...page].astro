---
import type { GetStaticPaths, GetStaticPathsOptions } from "astro";
import PostsListPage from "@/components/pages/PostsListPage.astro";
import { postListPaths } from "@/utils/localeRoutes";

export const getStaticPaths = (async (options: GetStaticPathsOptions) =>
  postListPaths(options, "en")) satisfies GetStaticPaths;
---

<PostsListPage page={Astro.props.page} />
