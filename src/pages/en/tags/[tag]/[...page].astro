---
import type { GetStaticPathsOptions } from "astro";
import TagPage from "@/components/pages/TagPage.astro";
import { tagPaths } from "@/utils/localeRoutes";

export async function getStaticPaths(options: GetStaticPathsOptions) {
  return tagPaths(options, "en");
}
---

<TagPage page={Astro.props.page} tagName={Astro.props.tagName} />
