---
import { render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { getLocalePage } from "@/utils/localeRoutes";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const about = await getLocalePage("about", locale);

if (!about) {
  throw new Error(
    `Missing content entry: about page for locale "${locale}". ` +
      "Expected `src/content/pages/about.md` for the default locale, " +
      "or `src/content/pages/_<locale>/about.md` for the others."
  );
}

const { Content } = await render(about);
---

<Layout
  title={`${about.data.title} | ${config.site.title}`}
  description={about.data.description}
  ogImage={about.data.ogImage}
  canonicalURL={about.data.canonicalURL}
>
  <Header />
  <Breadcrumb />
  <Main pageTitle={about.data.title} class="app-prose">
    <Content />
  </Main>
  <Footer />
</Layout>
